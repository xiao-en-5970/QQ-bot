# QQ-bot 生产环境配置模板
# 部署服务器：将本文件复制为 /qq-bot-server/.env，按实际值填写
# CI/CD 部署时 docker run --env-file 注入容器
# YAML 配置不再使用，全部走环境变量

# ============================================================
# NapCat HTTP 接口
# ============================================================
# NapCat OneBot11 HTTP server 的根地址，必须以 / 结尾
# 局域网/反代直连：https://bot-http.xiaoen.xyz/
# 容器走宿主机时：http://172.17.0.1:3000/  （docker 网桥网关，更稳）
SERVER_ADDRESS=https://bot-http.xiaoen.xyz/

# NapCat WebUI -> 网络配置 -> HTTP server 中的 token
SERVER_ACCESS_TOKEN=http-theo5970

# ============================================================
# 日志
# ============================================================
# 输出到标准输出 (docker logs) 的日志等级：debug/info/warn/error
LOG_STD_OUT_LOG_LEVEL=info
# 输出到日志文件的等级
LOG_LOG_LEVEL=info
# 日志文件路径（容器内），留空走默认 /tmp/qq-bot/logs/qq-bot.log
# 与 -v /qq-bot-server/cache:/tmp/qq-bot 配合后持久化到宿主机 /qq-bot-server/cache/logs/qq-bot.log
LOG_LOG_FILE=

# ============================================================
# pixiv 第三方代理
# ============================================================
PIXIV_PIXIV_ADDRESS=https://image.anosu.top/pixiv/json
PIXIV_SIZE=origin

# ============================================================
# 群聊轮询参数
# ============================================================
# 注：GROUP_GROUP_ID（群号列表）暂不支持 env，留空让程序自动从 NapCat 拉群列表
GROUP_GET_GROUP_HISTORY_INTERVAL=3
GROUP_UPDATE_GROUP_LIST_INTERVAL=1200
GROUP_RETRY=3

# ============================================================
# 缓存（容器内默认在 /tmp/qq-bot 下；通过 -v /qq-bot-server/cache:/tmp/qq-bot 持久化到宿主机）
# 留空即按代码默认值，无需在生产环境改动
# ============================================================
# CACHE_TMP_DIR=/tmp/qq-bot/jm
# CACHE_PDF_TMP_DIR=/tmp/qq-bot/pdf
CACHE_MAX_SIZE=1024
CACHE_CLEAR_INTERVAL=1200

# ============================================================
# 跨平台外部工具（容器内 jmcomic / img2pdf 已在 PATH，留空即可）
# ============================================================
# TOOLS_JMCOMIC_BIN=jmcomic
# TOOLS_IMG2PDF_BIN=img2pdf
# TOOLS_PYTHON_BIN=python3
